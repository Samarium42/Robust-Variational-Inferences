\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Full pipeline for robust credal variational inference. Phase 1 generates and caches HMC posterior samples per prior. Phase 2 trains a shared conditional flow matching model. At inference, $K$ ODE integrations produce approximate posteriors. Phase 3 selects optimal mixture weights via EM on the simplex.}}{48}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Phase 1: HMC posterior sampling. For each prior $\pi _k \in \Pi $, 3{,}000 posterior samples are generated after a 1{,}000-step warmup and cached to disk for reuse across all training runs.}}{53}{figure.3.2}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Phase 2: Conditional Flow Matching training. A single shared \texttt {VelocityResNet} is trained jointly across all $K$ priors using the simulation-free CFM objective.}}{54}{figure.3.3}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Phase 3: EM weight optimisation on $\Delta _{K-1}$. The E-step and M-step alternate until convergence, producing optimal mixture weights $\hat {w}$ that minimise the held-out negative log-likelihood.}}{58}{figure.3.4}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Architectural ablation: shared conditional model vs separately trained flows. Left: training loss curves. Centre: predictive log-likelihood under uniform mixture weights ($-0.4929$ vs $-0.5028$). Right: parameter count (888.6k vs 2665.7k, a 67\% reduction with the shared model).}}{67}{figure.4.1}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Prior sensitivity analysis on German Credit ($n = 75$). Left: posterior mean shift per dimension relative to the Gaussian prior. Right: maximum absolute mean shift across dimensions per prior. The credal mixture (dashed line, 0.004) is an order of magnitude more stable than the most sensitive individual prior (GaussianWide, 0.028).}}{68}{figure.4.2}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces EM mixture weight distribution across 10 seeds. Left: box plots showing mean and variance per prior (Cauchy: $0.26 \pm 0.194$; Gaussian: $0.24 \pm 0.164$; Laplace: $0.19 \pm 0.165$; Student-T: $0.16 \pm 0.126$; GaussianWide: $0.15 \pm 0.126$). Right: per-seed weight heatmap showing that the dominant prior changes across data subsamples.}}{69}{figure.4.3}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Leave-One-Prior-Out analysis. Left: change in predictive log-likelihood when each prior is removed ($\Delta > 0$ means the four-component mixture is better). Right: absolute predictive log-likelihood for all configurations.}}{70}{figure.4.4}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Calibration analysis on German Credit full-data regime. Left: reliability diagrams. Right: ECE and Brier score per method.}}{71}{figure.4.5}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Optimiser convergence on German Credit full-data regime. Left: convergence of mixture predictive log-likelihood across iterations. Right: final weight vectors for each algorithm. PGD and EM converge to near-identical solutions ($\|\Delta w\|_2 < 0.01$) while Frank-Wolfe degenerates to a sparse solution assigning weight $\approx 1.0$ to Student-T.}}{72}{figure.4.6}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Flow matching vs CNF training speed comparison. Left: per-step time distributions over 200 trials. Centre: flow matching training loss curve (CNF not trained to convergence). Right: test NLL per prior under flow matching.}}{73}{figure.4.7}%
